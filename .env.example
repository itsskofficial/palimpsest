# palimpsest configuration. Copy to `.env` and fill in what you need.
#
# Two keys make this useful: NOTION_TOKEN and ANTHROPIC_API_KEY. Everything else has a
# working default or a local fallback.
#
# Nothing here grants permission to WRITE. That is PALIMPSEST_APPLY, at the bottom, and
# it is off.

# ---------------------------------------------------------------------------
# Notion — required for everything that touches your workspace.
# ---------------------------------------------------------------------------
# Create an internal integration at https://www.notion.so/my-integrations, copy the
# secret, then SHARE AT LEAST ONE PAGE WITH IT. An integration sees nothing until you
# do, and the symptom is an empty sync rather than an error.
# NOTION_TOKEN=ntn_...

# Pinned deliberately. Notion versions its API by date and the 2025-09-03 release split
# databases into data sources; letting this float changes response shapes under a
# running deployment.
# NOTION_VERSION=2026-03-11

# Restrict the mirror to these page ids and their descendants. Comma-separated.
# Leave unset to mirror everything shared with the integration.
# The first id is also where a claim that fits nowhere gets a new page.
# PALIMPSEST_NOTION_ROOTS=

# ---------------------------------------------------------------------------
# The model — required for extraction, classification and the contradiction sweep.
# The mirror, retrieval, `sweep duplicates`, `sweep questions`, `sweep stale`
# and `undo` all work without it.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# PALIMPSEST_MODEL=claude-opus-5

# Effort per job. Extraction is mechanical; classification is the judgment call the
# whole product rests on. low | medium | high | xhigh | max
# PALIMPSEST_EXTRACT_EFFORT=medium
# PALIMPSEST_CLASSIFY_EFFORT=high
# PALIMPSEST_MAX_TOKENS=16000

# ---------------------------------------------------------------------------
# Ingestion — all optional. Each has a working fallback.
# ---------------------------------------------------------------------------
# Firecrawl handles JavaScript rendering and boilerplate stripping. Without it a
# stdlib HTML reader is used, which covers static pages fine.
# FIRECRAWL_API_KEY=fc-...

# Dense retrieval on top of the built-in BM25 index. Optional: the lexical index is
# what the sweeps and the classifier's candidate generation actually run on.
# OPENAI_API_KEY=
# PALIMPSEST_EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Storage.
# ---------------------------------------------------------------------------
# SQLite by default — one file you can copy or delete. Postgres/Supabase for a
# deployment. Supabase connection strings are Postgres URLs and work unchanged.
# PALIMPSEST_DATABASE_URL=sqlite:///palimpsest.db

# Supabase Cloud: Dashboard -> Project Settings -> Database -> Connection string.
# Use the TRANSACTION POOLER (port 6543) for the running service. Migrations need the
# session pooler or the direct URL (5432); `palimpsest db migrate` refuses the
# transaction pooler and explains why.
# PALIMPSEST_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Or let palimpsest build that URL:
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
# SUPABASE_REGION=ap-south-1

# Supabase API, for Storage. The service-role key bypasses RLS: backend only, never
# in a browser.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Where the original bytes of every ingested source are archived, so citations still
# resolve when the web moves on.
#   file://./archive   s3://bucket/prefix   supabase://bucket/prefix
# PALIMPSEST_ARTIFACT_URL=file://./archive

# ---------------------------------------------------------------------------
# Permission to write. Both default to off, and they are independent.
# ---------------------------------------------------------------------------
# Nothing is ever written to Notion unless this is on.
# PALIMPSEST_APPLY=0

# The highest RISK TIER that may be applied without a human:
#   none    review everything (default)
#   low     `new` and `corroborates` apply automatically
#   medium  also `refines`, `supersedes`, `duplicate`, `extends`
# There is deliberately no `high`. Contradictions are never automatic.
# PALIMPSEST_AUTONOMY=none

# Below this classifier confidence, a judgement goes to review regardless of relation.
# PALIMPSEST_MIN_CONFIDENCE=0.75

# Write a provenance footnote under every edited block.
# PALIMPSEST_FOOTNOTES=1

# ---------------------------------------------------------------------------
# The Telegram bot. Message @BotFather, send /newbot, paste the token here.
#
# The allowlist is not optional. A bot token is a bearer credential — anyone who
# finds your bot can message it — so an empty allowlist refuses every chat and
# replies with that chat's id. Message the bot once, copy the id it gives you,
# put it here, restart. Group ids are negative; keep the minus sign.
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHATS=123456789

# ---------------------------------------------------------------------------
# Observability. With these set, every model call, tool call and agent turn is
# traced to Langfuse — costs, latency, tool errors, and the reasoning behind each
# edit, correlated by patch/job/chat id. Absent, tracing is a silent no-op and
# nothing depends on it. Secrets are masked before anything leaves the process.
# ---------------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# ---------------------------------------------------------------------------
# The Notion-side ledger: two databases under your root page recording every
# change, why it was made, and what reverts it. Needs PALIMPSEST_NOTION_ROOTS,
# since that is where they get created. On by default.
# ---------------------------------------------------------------------------
# PALIMPSEST_JOURNAL=1

# ---------------------------------------------------------------------------
# Speech to text, for lectures, meetings and voice memos. Set any one of these.
# Whichever is present is used, in the order below, unless PALIMPSEST_TRANSCRIBE
# names one. There is deliberately no offline fallback: a transcript you did not
# get is not a source, so a recording fails loudly rather than becoming an empty one.
# ---------------------------------------------------------------------------
# Best for long recordings. No practical size cap, word-level timings, and it
# labels speakers — which is usually why you recorded a meeting in the first place.
# DEEPGRAM_API_KEY=
#
# Whisper large-v3. Cheapest way to start and very fast, but rejects files over 25 MB
# (roughly an hour of compressed speech).
# GROQ_API_KEY=
#
# Indian languages and Hinglish, where Whisper and Deepgram both degrade badly on
# code-switching mid-sentence.
# SARVAM_API_KEY=
#
# PALIMPSEST_TRANSCRIBE=deepgram

# ---------------------------------------------------------------------------
# The review app. Only needed when it listens on something other than localhost —
# the app refuses to bind publicly without a key.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
# PALIMPSEST_API_KEY=
# PALIMPSEST_HOST=127.0.0.1
# PALIMPSEST_PORT=8100
# PALIMPSEST_CORS_ORIGINS=
# PALIMPSEST_LOG_JSON=0
# PALIMPSEST_ENV=local

# A browser extension calls from chrome-extension://<id>, and the id is not known
# until the extension is loaded, so it has to be matched rather than listed. This is
# already the default on a local-only bind — set it only for a non-local server.
# PALIMPSEST_CORS_ORIGIN_REGEX=^chrome-extension://.*$

# ---------------------------------------------------------------------------
# The capture queue. The extension and the desktop app post to /v1/jobs and return
# immediately; these threads drain it. Two is right for one person: ingestion waits
# on the model, not on local CPU.
# ---------------------------------------------------------------------------
# PALIMPSEST_WORKERS=2
