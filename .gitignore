__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.DS_Store
results/*.log

# the browser extension, desktop app and web UI
node_modules/
clients/desktop/out/
clients/desktop/dist/
clients/extension/*.zip
clients/ui/.next/
clients/ui/*.tsbuildinfo
# `clients/ui/out/` is a build artifact; the copy that ships lives in
# src/palimpsest/serve/static/, which is committed so a pip install needs no Node.
clients/ui/out/

# local platform artifacts
archive/
*.db
*.db-wal
*.db-shm
# The local mirror/archive directory at the repo root — NOT `src/**/data`, which is
# packaged fixture content. An unanchored `data/` swallowed the eval workspace, so the
# golden set was neither committed nor shipped in the wheel.
/data/

# secrets and local state
.env
.env.local
deploy/.env
supabase/.temp/
supabase/.branches/
*.tfvars
.terraform/
*.tfstate
*.tfstate.*
